EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium
# Set to 1 on an emulator without Google Play Billing to skip RevenueCat and
# silence its BILLING_UNAVAILABLE errors. Leave unset / 0 for device testing.
EXPO_PUBLIC_DISABLE_PURCHASES=0

# ── Cloudflare R2 (yalnızca scripts/ tarafı — uygulamaya GİRMEZ) ──────────
# Ses + kapak dosyaları burada barınır; uygulama sadece tracks tablosundaki
# hazır public URL'i çeker. Bkz. scripts/r2.mjs, scripts/migrate-storage-to-r2.mjs
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pulvio-media
R2_PUBLIC_BASE=https://cdn.pulvio.mehmtcankilinc.com
