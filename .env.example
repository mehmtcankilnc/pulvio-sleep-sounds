EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium
# Set to 1 on an emulator without Google Play Billing to skip RevenueCat and
# silence its BILLING_UNAVAILABLE errors. Leave unset / 0 for device testing.
EXPO_PUBLIC_DISABLE_PURCHASES=0
